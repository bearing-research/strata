# Git
.git
.gitignore

# Python. The ** patterns reach into src/: a bare *.so or __pycache__
# matches only at the context root, and the build packages what it finds there.
**/__pycache__
**/*.py[cod]
.Python
**/*.so
.venv
venv
env
.pytest_cache
*.egg-info
dist
build

# IDE
.idea
.vscode
*.swp
*.swo

# Cache
.strata
demo-warehouse
*.sqlite

# Tests
tests/
.coverage
htmlcov

# Frontend. The image builds its own; a copy left in src/strata/_frontend
# would be packaged into the wheel and served ahead of it.
frontend/node_modules
frontend/dist
src/strata/_frontend

# OS
**/.DS_Store

# Docs
docs/
*.md
!README.md
