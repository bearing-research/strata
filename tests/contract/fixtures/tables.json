{
  "source": "ADR 002 §3, §9 E0; packages/vestigo/src/vestigo/tables.py and src/strata/notebook/worker_store.py as of E1 (#1294)",
  "notes": [
    "ledger lists every table the package creates, in the foreign-key order a copy must follow (artifact_versions first).",
    "migrated=false tables are rebuilt or left behind by `strata migrate`: schema_version is the target's own, import_staging and build_console_chunks hold only live rows.",
    "strata_owned tables share the database and the dialect but belong to Strata and are created by Strata modules, never by the ledger."
  ],
  "ledger": [
    {
      "name": "artifact_versions",
      "migrated": true,
      "primary_key": ["id", "version"]
    },
    {
      "name": "artifact_names",
      "migrated": true,
      "primary_key": ["tenant", "name"]
    },
    {
      "name": "artifact_aliases",
      "migrated": true,
      "primary_key": ["tenant", "name", "alias"]
    },
    {
      "name": "artifact_tags",
      "migrated": true,
      "primary_key": ["tenant", "artifact_id", "version", "key"]
    },
    { "name": "registry_audit", "migrated": true, "primary_key": ["seq"] },
    {
      "name": "registry_pending",
      "migrated": true,
      "primary_key": ["tenant", "name", "alias"]
    },
    {
      "name": "artifact_publications",
      "migrated": true,
      "primary_key": ["token"]
    },
    {
      "name": "artifact_pins",
      "migrated": true,
      "primary_key": ["artifact_id", "version", "reason"]
    },
    {
      "name": "artifact_builds",
      "migrated": true,
      "primary_key": ["build_id"]
    },
    {
      "name": "build_attempts",
      "migrated": true,
      "primary_key": ["build_id", "attempt"]
    },
    { "name": "schema_version", "migrated": false },
    { "name": "import_staging", "migrated": false },
    { "name": "build_console_chunks", "migrated": false }
  ],
  "strata_owned": [
    {
      "name": "notebook_workers",
      "created_by": "src/strata/notebook/worker_store.py"
    },
    {
      "name": "notebook_worker_registry",
      "created_by": "src/strata/notebook/worker_store.py"
    },
    { "name": "api_keys", "created_by": "src/strata/auth/api_keys.py" },
    {
      "name": "stream_owners",
      "created_by": "src/strata/streaming/ownership.py"
    }
  ]
}
