# Names the warehouse in docker-compose.yml as the catalog `lake`. The empty header
# says this catalog hands out no storage credentials, so the s3.* keys are used.
export STRATA_CATALOGS='{"lake": {"type": "rest", "uri": "http://localhost:8181", "warehouse": "s3://warehouse/", "header.X-Iceberg-Access-Delegation": "", "s3.endpoint": "http://localhost:9000", "s3.access-key-id": "strata", "s3.secret-access-key": "strata-example", "s3.region": "us-east-1", "s3.path-style-access": "true"}}'
